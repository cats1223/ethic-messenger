{
  "name": "ethic-messenger-desktop",
  "productName": "Ethic Messenger",
  "version": "2.7.0",
  "description": "Ethic Messenger для Windows",
  "author": "Ethic",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.ethic.messenger",
    "productName": "Ethic Messenger",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload-picker.js", "preload-splash.js", "picker.html", "offline.html", "splash.html", "build/tray.png", "build/icon.png", "build/logo.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ethic Messenger",
      "artifactName": "Ethic-Messenger-Setup.exe"
    }
  }
}
